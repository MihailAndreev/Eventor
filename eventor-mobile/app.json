{
  "expo": {
    "name": "eventor-mobile",
    "slug": "eventor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eventormobile",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f5f0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
